{
  "name": "civicbridge",
  "version": "1.0.0",
  "description": "CivicBridge - Gemini-powered civic complaint structuring, verification, and action planner for Pune, India",
  "main": "server/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "NODE_ENV=test node --test server/tests/*.test.js",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"server/**/*.{js,json}\" \"public/**/*.{js,html,css}\" \"eslint.config.js\" \".prettierrc.json\" \"package.json\""
  },
  "keywords": [
    "civic-tech",
    "gemini-api",
    "pune",
    "pmc",
    "complaint-structuring",
    "mcp"
  ],
  "author": "CivicBridge Team",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
