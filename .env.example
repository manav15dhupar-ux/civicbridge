# CivicBridge Configuration
# Port for the Express server (Render injects PORT automatically)
PORT=3000

# Google Gemini API Key (Required for live Gemini AI structuring and verification)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model to use (default: gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Node Environment
NODE_ENV=development

# Allowed CORS Origin (Optional, defaults to same-origin in production)
ALLOWED_ORIGIN=http://localhost:3000
